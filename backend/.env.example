# MongoDB connection string (local MongoDB by default)
MONGO_URI=mongodb://127.0.0.1:27017/hostel_complaint_tracker

# Secret used to sign JWTs — MUST be a long random string (min 16 chars).
# The server refuses to start without a real one; there is no fallback.
JWT_SECRET=your_secret_here

# JWT lifetime (e.g. 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Requests per 15 minutes allowed on /api/auth/login and /api/auth/register
AUTH_RATE_LIMIT=50

# Backend port
PORT=5000

# development | production
NODE_ENV=development
